digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.15", nodesep="0.32", ranksep="0.20", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=17, margin="0.17,0.08", penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=14, color="#8091A4", fontcolor="#53647B", arrowsize=0.65, penwidth=1.2];
a [label=<<B>Titular del proyecto</B><BR/>Pagar aporte urbanístico>,shape=box,fillcolor="#EEF0F3",color="#687888",fontcolor="#172E47"];
b [label=<<B>Municipalidad</B><BR/>Cuenta especial de aportes>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
c [label=<<B>¿Obra en plan<BR/>comunal o intercomunal?</B>>,shape=diamond,fillcolor="#FFF0CE",color="#AD8425",fontcolor="#172E47"];
d [label=<<B>SECPLA → concejo / alcalde</B><BR/>PIIMEP comunal<BR/>Aprobación y promulgación>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
e [label=<<B>SEREMI MINVU + MTT → GORE</B><BR/>Plan intercomunal<BR/>Alcaldes, CORE y gobernador>,shape=box,fillcolor="#EFE9FA",color="#7960A3",fontcolor="#172E47"];
f [label=<<B>Municipio / ejecutor<BR/>competente</B><BR/>Priorizar plaza y recursos<BR/>Respetar destinos legales>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
g [label=<<B>Ejecutor → municipio</B><BR/>Obra T02 y entrega<BR/>Mantención posterior>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
a -> b [label="aporte previo a\nrecepción"];
b -> f [label="disponibilidad\nfinanciera"];
c -> d [label="comunal"];
c -> e [label="intercomunal"];
d -> f [label="cartera aprobada"];
e -> f [label="cartera aprobada"];
f -> g [label="presupuesto /\nconvenio"];
}