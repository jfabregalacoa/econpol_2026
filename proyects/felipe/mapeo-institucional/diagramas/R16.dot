digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.15", nodesep="0.32", ranksep="0.20", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=17, margin="0.17,0.08", penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=14, color="#8091A4", fontcolor="#53647B", arrowsize=0.65, penwidth=1.2];
a [label=<<B>Alcalde + SECPLA / finanzas</B><BR/>Proyecto y capacidad<BR/>financiera municipal>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
b [label=<<B>SUBDERE</B><BR/>Verificar elegibilidad<BR/>y antecedentes>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
c [label=<<B>DIPRES / Hacienda</B><BR/>Revisar operación<BR/>y autorización>,shape=box,fillcolor="#FFF0CE",color="#AD8425",fontcolor="#172E47"];
d [label=<<B>SUBDERE</B><BR/>Resolución de aporte<BR/>visada por DIPRES>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
e [label=<<B>Alcalde + concejo</B><BR/>Autorizar compromiso<BR/>y convenio de reembolso>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
f [label=<<B>Municipio ↔ Tesorería</B><BR/>Formalizar transferencia<BR/>y mecanismo de devolución>,shape=box,fillcolor="#FFF0CE",color="#AD8425",fontcolor="#172E47"];
g [label=<<B>Municipalidad</B><BR/>Ejecutar obra, mantener<BR/>y pagar reembolso>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
a -> b [label="solicitud"];
b -> a [label="",constraint=false,style=dashed];
b -> c [label=""];
c -> d [label=""];
d -> e [label=""];
e -> f [label="acuerdo"];
f -> g [label=""];
}