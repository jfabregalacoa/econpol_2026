digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.15", nodesep="0.32", ranksep="0.20", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=17, margin="0.17,0.08", penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=14, color="#8091A4", fontcolor="#53647B", arrowsize=0.65, penwidth=1.2];
a [label=<<B>Necesidad territorial</B><BR/>Crear, recuperar<BR/>o cuidar una plaza>,shape=box,fillcolor="#FBE9E0",color="#AA6243",fontcolor="#172E47"];
b [label=<<B>¿Qué intervención<BR/>se requiere?</B>>,shape=diamond,fillcolor="#FFF0CE",color="#AD8425",fontcolor="#172E47"];
c [label=<<B>Nueva / transformación</B><BR/>Formular inversión<BR/>R01-R22 según elegibilidad>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
d [label=<<B>Conservación del activo</B><BR/>Regional/mixta R26<BR/>Sectorial R27>,shape=box,fillcolor="#EFE9FA",color="#7960A3",fontcolor="#172E47"];
e [label=<<B>Cuidado recurrente</B><BR/>Directo R24 / contratado R25<BR/>Parques elegibles R28>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
f [label=<<B>Administrador + financiador</B><BR/>Acordar suelo, competencias<BR/>y costo de ciclo de vida>,shape=box,fillcolor="#FFF0CE",color="#AD8425",fontcolor="#172E47"];
a -> b [label=""];
b -> c [label="nueva /\nrecuperación"];
b -> d [label="conservación"];
b -> e [label="mantención"];
c -> f [label=""];
d -> f [label=""];
e -> f [label=""];
}