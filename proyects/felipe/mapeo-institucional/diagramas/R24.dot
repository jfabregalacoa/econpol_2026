digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.15", nodesep="0.32", ranksep="0.20", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=17, margin="0.17,0.08", penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=14, color="#8091A4", fontcolor="#53647B", arrowsize=0.65, penwidth=1.2];
a [label=<<B>Recepción de obra / vecinos<BR/>/ inspectores</B><BR/>Inventario y detección<BR/>de necesidades>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
b [label=<<B>Jefatura de áreas verdes</B><BR/>Programar tareas, frecuencias<BR/>y recursos>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
c [label=<<B>Alcalde + concejo</B><BR/>Presupuesto operativo<BR/>y dotación autorizada>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
d [label=<<B>Supervisor + cuadrillas</B><BR/>Riego, aseo, jardinería<BR/>y reparaciones menores>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
e [label=<<B>Inspector / jefatura</B><BR/>Verificar estado<BR/>y cumplimiento>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
f [label=<<B>¿Basta la mantención<BR/>habitual?</B>>,shape=diamond,fillcolor="#FFF0CE",color="#AD8425",fontcolor="#172E47"];
g [label=<<B>SECPLA / unidad de<BR/>proyectos</B><BR/>Formular conservación<BR/>o inversión mayor>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
a -> b [label=""];
b -> c [label="necesidades\npresupuestarias"];
c -> d [label="recursos e\ninstrucciones"];
d -> e [label="registro de\ntrabajos"];
e -> f [label=""];
f -> b [label="sí",constraint=false,style=dashed];
f -> g [label="no"];
g -> a [label="",constraint=false,style=dashed];
}