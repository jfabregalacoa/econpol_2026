digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.15", nodesep="0.32", ranksep="0.20", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=17, margin="0.17,0.08", penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=14, color="#8091A4", fontcolor="#53647B", arrowsize=0.65, penwidth=1.2];
a [label=<<B>Equipo municipal + barrio</B><BR/>Plan de Revitalización<BR/>Priorizar plaza>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
b [label=<<B>Municipio</B><BR/>Preparar proyecto, suelo<BR/>y autorizaciones>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
c [label=<<B>Unidad Regional SUBDERE</B><BR/>Revisar presentación>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
d [label=<<B>Unidad Ejecutora PRBIPE</B><BR/>Evaluar elegibilidad<BR/>y condiciones de inversión>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
e [label=<<B>SUBDERE ↔ municipio</B><BR/>Asignar recursos<BR/>y formalizar convenio>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
f [label=<<B>Municipio</B><BR/>Obra, supervisión<BR/>y rendición>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
g [label=<<B>Operador municipal</B><BR/>Recepción y mantención>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
a -> b [label="cartera del plan"];
b -> c [label="plataforma /\nexpediente"];
c -> d [label=""];
d -> b [label="",constraint=false,style=dashed];
d -> e [label="habilitado y\npriorizado"];
e -> f [label=""];
f -> g [label=""];
}