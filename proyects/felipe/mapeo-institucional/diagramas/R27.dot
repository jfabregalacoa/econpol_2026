digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.15", nodesep="0.32", ranksep="0.20", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=17, margin="0.17,0.08", penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=14, color="#8091A4", fontcolor="#53647B", arrowsize=0.65, penwidth=1.2];
a [label=<<B>Servicio / profesional<BR/>competente</B><BR/>Diagnosticar daño<BR/>y valorar activo>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
b [label=<<B>Institución financiera</B><BR/>Oficio, BIP y certificado<BR/>Memoria y expediente>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
c [label=<<B>MDSF / SEREMI</B><BR/>Admisibilidad y análisis<BR/>de conservación>,shape=box,fillcolor="#FFF0CE",color="#AD8425",fontcolor="#172E47"];
d [label=<<B>¿Clasificación y<BR/>antecedentes conformes?</B>>,shape=diamond,fillcolor="#FFF0CE",color="#AD8425",fontcolor="#172E47"];
e [label=<<B>Formulador</B><BR/>Subsanar o reclasificar>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
f [label=<<B>Financiador sectorial</B><BR/>Resultado habilitante<BR/>y asignación presupuestaria>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
g [label=<<B>Unidad ejecutora</B><BR/>Contratar conservación<BR/>y recibir trabajos>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
h [label=<<B>Operador</B><BR/>Mantención habitual>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
a -> b [label=""];
b -> c [label=""];
c -> d [label=""];
d -> e [label="no"];
e -> b [label="",constraint=false,style=dashed];
d -> f [label="sí"];
f -> g [label=""];
g -> h [label=""];
}