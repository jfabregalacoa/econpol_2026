digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.15", nodesep="0.32", ranksep="0.20", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=17, margin="0.17,0.08", penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=14, color="#8091A4", fontcolor="#53647B", arrowsize=0.65, penwidth=1.2];
a [label=<<B>SPD ↔ municipalidad</B><BR/>Asignación y convenio<BR/>según programa>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
b [label=<<B>Seguridad municipal +<BR/>SECPLA</B><BR/>Diagnóstico de seguridad<BR/>y diseño participativo>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
c [label=<<B>Municipio → SPD</B><BR/>Ingresar proyecto REP<BR/>en SIEVAP>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
d [label=<<B>Equipo evaluador SPD</B><BR/>Revisar coherencia<BR/>y viabilidad técnica>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
e [label=<<B>¿Proyecto aprobado<BR/>y recursos habilitados?</B>>,shape=diamond,fillcolor="#FFF0CE",color="#AD8425",fontcolor="#172E47"];
f [label=<<B>Equipo municipal</B><BR/>Subsanar o reformular>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
g [label=<<B>Municipalidad</B><BR/>Contratar, ejecutar<BR/>e informar / rendir>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
h [label=<<B>Municipio + comunidad</B><BR/>Operación y gestión social<BR/>Mantención comprometida>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
a -> b [label=""];
b -> c [label="expediente"];
c -> d [label=""];
d -> e [label=""];
e -> f [label="no"];
f -> c [label="",constraint=false,style=dashed];
e -> g [label="sí"];
g -> h [label=""];
}