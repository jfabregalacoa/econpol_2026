digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.15", nodesep="0.32", ranksep="0.20", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=17, margin="0.17,0.08", penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=14, color="#8091A4", fontcolor="#53647B", arrowsize=0.65, penwidth=1.2];
a [label=<<B>Gobernador + equipos GORE</B><BR/>Identificar necesidad<BR/>regional o intercomunal>,shape=box,fillcolor="#EFE9FA",color="#7960A3",fontcolor="#172E47"];
b [label=<<B>GORE ↔ municipio / servicio</B><BR/>Acordar alcance, suelo<BR/>y futuro operador>,shape=box,fillcolor="#EFE9FA",color="#7960A3",fontcolor="#172E47"];
c [label=<<B>Servicio o equipo<BR/>formulador</B><BR/>Desarrollar diseño y BIP>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
d [label=<<B>Evaluador / financiador</B><BR/>Habilitar inversión · T01>,shape=box,fillcolor="#FFF0CE",color="#AD8425",fontcolor="#172E47"];
e [label=<<B>Gobernador + CORE</B><BR/>Priorizar y aprobar recursos<BR/>según competencias>,shape=box,fillcolor="#EFE9FA",color="#7960A3",fontcolor="#172E47"];
f [label=<<B>GORE ↔ unidad técnica</B><BR/>Formalizar mandato<BR/>y responsabilidades>,shape=box,fillcolor="#EFE9FA",color="#7960A3",fontcolor="#172E47"];
g [label=<<B>Unidad ejecutora</B><BR/>Contratar obra · T02>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
h [label=<<B>Municipio u otro operador</B><BR/>Recepción y mantención<BR/>según convenio>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
a -> b [label="cartera regional"];
b -> c [label="encargo / convenio"];
c -> d [label="expediente"];
d -> c [label="",constraint=false,style=dashed];
d -> e [label="habilitado"];
e -> f [label="resolución"];
f -> g [label=""];
g -> h [label="entrega formal"];
}