digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.15", nodesep="0.32", ranksep="0.20", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=17, margin="0.17,0.08", penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=14, color="#8091A4", fontcolor="#53647B", arrowsize=0.65, penwidth=1.2];
a [label=<<B>SUBDERE → gobernador / CORE</B><BR/>Distribuir recursos<BR/>regionales y comunales>,shape=box,fillcolor="#EFE9FA",color="#7960A3",fontcolor="#172E47"];
b [label=<<B>Municipio / SECPLA</B><BR/>Ingresar proyecto en<BR/>SUBDERE en Línea>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
c [label=<<B>Unidad Regional SUBDERE</B><BR/>Revisar expediente>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
d [label=<<B>Gobernador regional</B><BR/>Visar mediante oficio<BR/>a SUBDERE>,shape=box,fillcolor="#EFE9FA",color="#7960A3",fontcolor="#172E47"];
e [label=<<B>SUBDERE central</B><BR/>Evaluación técnica<BR/>y elegibilidad>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
f [label=<<B>¿Asignación<BR/>de recursos?</B>>,shape=diamond,fillcolor="#FFF0CE",color="#AD8425",fontcolor="#172E47"];
g [label=<<B>Municipio</B><BR/>Mantener cartera vigente<BR/>o reformular>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
h [label=<<B>Municipio</B><BR/>Ejecutar, rendir y mantener>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
a -> b [label=""];
b -> c [label=""];
c -> b [label="",constraint=false,style=dashed];
c -> d [label="conforme"];
d -> e [label="oficio incorporado"];
e -> f [label=""];
f -> g [label="pendiente / no"];
f -> h [label="resolución"];
}