digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.15", nodesep="0.32", ranksep="0.20", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=17, margin="0.17,0.08", penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=14, color="#8091A4", fontcolor="#53647B", arrowsize=0.65, penwidth=1.2];
a [label=<<B>GORE + CORE</B><BR/>Definir marco y<BR/>condiciones regionales>,shape=box,fillcolor="#EFE9FA",color="#7960A3",fontcolor="#172E47"];
b [label=<<B>¿La plaza es elegible<BR/>en estas bases?</B>>,shape=diamond,fillcolor="#FFF0CE",color="#AD8425",fontcolor="#172E47"];
c [label=<<B>Municipio</B><BR/>Buscar otra vía>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
d [label=<<B>Alcalde + SECPLA</B><BR/>Presentar expediente<BR/>con registro BIP>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
e [label=<<B>Equipo técnico GORE</B><BR/>Revisar y observar>,shape=box,fillcolor="#EFE9FA",color="#7960A3",fontcolor="#172E47"];
f [label=<<B>GORE ↔ municipio</B><BR/>Asignación y convenio<BR/>de transferencia>,shape=box,fillcolor="#EFE9FA",color="#7960A3",fontcolor="#172E47"];
g [label=<<B>Municipio</B><BR/>Obra T02, rendición<BR/>y mantención>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
a -> b [label="bases /\ndistribución"];
b -> c [label="no"];
b -> d [label="sí"];
d -> e [label="oficio y carpeta"];
e -> d [label="",constraint=false,style=dashed];
e -> f [label="aprobación y\nrecursos"];
f -> g [label=""];
}