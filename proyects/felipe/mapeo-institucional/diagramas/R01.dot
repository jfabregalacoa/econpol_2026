digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.15", nodesep="0.32", ranksep="0.20", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=17, margin="0.17,0.08", penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=14, color="#8091A4", fontcolor="#53647B", arrowsize=0.65, penwidth=1.2];
a [label=<<B>Vecinos / alcalde /<BR/>unidades</B><BR/>Necesidad y propuesta>,shape=box,fillcolor="#FBE9E0",color="#AA6243",fontcolor="#172E47"];
b [label=<<B>SECPLA y equipo técnico</B><BR/>Terreno, diseño y costos<BR/>Incluye costo de operación>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
c [label=<<B>Alcalde → concejo</B><BR/>Propuesta y aprobación<BR/>presupuestaria>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
d [label=<<B>¿Recursos y<BR/>condiciones habilitantes?</B>>,shape=diamond,fillcolor="#FFF0CE",color="#AD8425",fontcolor="#172E47"];
e [label=<<B>SECPLA / alcalde</B><BR/>Reformular o reprogramar>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
f [label=<<B>Municipalidad</B><BR/>Contratar y ejecutar<BR/>Ver proceso T02>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
g [label=<<B>Unidad de áreas verdes</B><BR/>Recibir activo y mantener<BR/>R24 o R25>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
a -> b [label="solicitud /\ndiagnóstico"];
b -> c [label="cartera y\npresupuesto"];
c -> d [label=""];
d -> e [label="no"];
e -> b [label="",constraint=false,style=dashed];
d -> f [label="sí"];
f -> g [label="acta y plan de\nmantención"];
}