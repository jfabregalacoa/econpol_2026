digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.15", nodesep="0.32", ranksep="0.20", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=17, margin="0.17,0.08", penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=14, color="#8091A4", fontcolor="#53647B", arrowsize=0.65, penwidth=1.2];
a [label=<<B>SEREMI + municipio /<BR/>comunidad</B><BR/>Identificar déficit<BR/>y plan urbano>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
b [label=<<B>SERVIU + proyectistas</B><BR/>Formular componente plaza<BR/>Suelo, diseño y costos>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
c [label=<<B>MINVU / institución<BR/>financiera</B><BR/>Postular inversión<BR/>a evaluación · T01>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
d [label=<<B>MDSF o régimen de exención</B><BR/>Habilitar técnicamente>,shape=box,fillcolor="#FFF0CE",color="#AD8425",fontcolor="#172E47"];
e [label=<<B>MINVU</B><BR/>Priorizar y programar<BR/>recursos sectoriales>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
f [label=<<B>SERVIU</B><BR/>Contratar e inspeccionar<BR/>obra · T02>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
g [label=<<B>SERVIU ↔ operador</B><BR/>Entregar activo<BR/>y activar mantención>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
a -> b [label=""];
b -> c [label="proyecto / BIP"];
c -> d [label=""];
d -> b [label="",constraint=false,style=dashed];
d -> e [label="habilitado"];
e -> f [label="presupuesto"];
f -> g [label="acta / convenio"];
}