digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.15", nodesep="0.32", ranksep="0.20", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=17, margin="0.17,0.08", penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=14, color="#8091A4", fontcolor="#53647B", arrowsize=0.65, penwidth=1.2];
a [label=<<B>Áreas verdes + finanzas</B><BR/>Inventario, niveles de servicio<BR/>y presupuesto aprobado>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
b [label=<<B>Unidad de compras / SECPLA</B><BR/>Bases y licitación<BR/>según régimen aplicable>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
c [label=<<B>Comisión → alcalde /<BR/>concejo</B><BR/>Evaluación y adjudicación<BR/>Acuerdos si corresponden>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
d [label=<<B>Municipio ↔ empresa</B><BR/>Contrato e inicio<BR/>Inspector designado>,shape=box,fillcolor="#EEF0F3",color="#687888",fontcolor="#172E47"];
e [label=<<B>Empresa + supervisor</B><BR/>Ejecutar servicios<BR/>según programación>,shape=box,fillcolor="#EEF0F3",color="#687888",fontcolor="#172E47"];
f [label=<<B>Inspector municipal</B><BR/>Comprobar prestaciones>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
g [label=<<B>¿Servicio conforme?</B>>,shape=diamond,fillcolor="#FFF0CE",color="#AD8425",fontcolor="#172E47"];
h [label=<<B>Empresa / municipio</B><BR/>Corregir y tramitar<BR/>medidas contractuales>,shape=box,fillcolor="#EEF0F3",color="#687888",fontcolor="#172E47"];
i [label=<<B>Finanzas municipales</B><BR/>Pagar prestación certificada<BR/>y continuar ciclo>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
a -> b [label=""];
b -> c [label="ofertas"];
c -> d [label="decreto / contrato"];
d -> e [label=""];
e -> f [label="informe de servicio"];
f -> g [label=""];
g -> h [label="no"];
h -> f [label="",constraint=false,style=dashed];
g -> i [label="sí"];
i -> e [label="",constraint=false,style=dashed];
}