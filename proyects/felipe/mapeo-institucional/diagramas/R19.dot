digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.15", nodesep="0.32", ranksep="0.20", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=17, margin="0.17,0.08", penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=14, color="#8091A4", fontcolor="#53647B", arrowsize=0.65, penwidth=1.2];
a [label=<<B>Interesado + profesionales</B><BR/>Proponer urbanización<BR/>voluntaria>,shape=box,fillcolor="#EEF0F3",color="#687888",fontcolor="#172E47"];
b [label=<<B>Municipalidad</B><BR/>Resolver autorización<BR/>previa de propuesta>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
c [label=<<B>¿Autorizada?</B>>,shape=diamond,fillcolor="#FFF0CE",color="#AD8425",fontcolor="#172E47"];
d [label=<<B>Interesado</B><BR/>Ajustar o desistir>,shape=box,fillcolor="#EEF0F3",color="#687888",fontcolor="#172E47"];
e [label=<<B>DOM</B><BR/>Permiso y condiciones<BR/>Garantías si corresponden>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
f [label=<<B>Interesado / constructor</B><BR/>Ejecutar obras>,shape=box,fillcolor="#EEF0F3",color="#687888",fontcolor="#172E47"];
g [label=<<B>DOM</B><BR/>Verificar y recibir>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
h [label=<<B>Municipio / administrador</B><BR/>Incorporar a operación<BR/>y mantención>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
a -> b [label="planos y memoria"];
b -> c [label=""];
c -> d [label="no"];
d -> a [label="",constraint=false,style=dashed];
c -> e [label="sí"];
e -> f [label=""];
f -> g [label="recepción"];
g -> h [label=""];
}