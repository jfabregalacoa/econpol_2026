digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.15", nodesep="0.32", ranksep="0.20", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=17, margin="0.17,0.08", penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=14, color="#8091A4", fontcolor="#53647B", arrowsize=0.65, penwidth=1.2];
a [label=<<B>Organización + Entidad<BR/>Patrocinante</B><BR/>Diagnosticar y formular<BR/>proyecto y aportes>,shape=box,fillcolor="#FBE9E0",color="#AA6243",fontcolor="#172E47"];
b [label=<<B>Municipalidad</B><BR/>Informe de pertinencia<BR/>y coordinación territorial>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
c [label=<<B>Entidad Patrocinante →<BR/>SERVIU</B><BR/>Presentar expediente<BR/>y antecedentes de terreno>,shape=box,fillcolor="#EEF0F3",color="#687888",fontcolor="#172E47"];
d [label=<<B>SERVIU</B><BR/>Habilitar y calificar>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
e [label=<<B>¿Cumple condiciones<BR/>y resulta seleccionado?</B>>,shape=diamond,fillcolor="#FFF0CE",color="#AD8425",fontcolor="#172E47"];
f [label=<<B>Organización + EP</B><BR/>Corregir / volver a postular>,shape=box,fillcolor="#FBE9E0",color="#AA6243",fontcolor="#172E47"];
g [label=<<B>MINVU / SERVIU + ejecutor</B><BR/>Subsidio, contrato y obra<BR/>Fiscalización técnica>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
h [label=<<B>Responsable del espacio</B><BR/>Recepción y mantención<BR/>municipal si corresponde>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
a -> b [label=""];
b -> c [label="informe"];
c -> d [label=""];
d -> e [label="calificación /\nselección MINVU"];
e -> f [label="no"];
f -> c [label="",constraint=false,style=dashed];
e -> g [label="sí"];
g -> h [label=""];
}