digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.15", nodesep="0.32", ranksep="0.20", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=17, margin="0.17,0.08", penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=14, color="#8091A4", fontcolor="#53647B", arrowsize=0.65, penwidth=1.2];
a [label=<<B>DOP + municipio /<BR/>territorio</B><BR/>Identificar tramo y<BR/>programa de borde>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
b [label=<<B>DOP + proyectista</B><BR/>Diseño, permisos<BR/>y evaluación SNI>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
c [label=<<B>¿Fuente de inversión?</B>>,shape=diamond,fillcolor="#FFF0CE",color="#AD8425",fontcolor="#172E47"];
d [label=<<B>MOP</B><BR/>Programación sectorial>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
e [label=<<B>Gobernador + CORE</B><BR/>Financiamiento regional>,shape=box,fillcolor="#EFE9FA",color="#7960A3",fontcolor="#172E47"];
f [label=<<B>DOP + inspector fiscal</B><BR/>Contratar y supervisar<BR/>obras de borde>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
g [label=<<B>DOP ↔ operador acordado</B><BR/>Recibir y distribuir<BR/>responsabilidades>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
h [label=<<B>Operadores correspondientes</B><BR/>Mantener infraestructura<BR/>y equipamiento>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
a -> b [label=""];
b -> c [label="proyecto habilitado"];
c -> d [label="sectorial"];
c -> e [label="FNDR / convenio"];
d -> f [label=""];
e -> f [label=""];
f -> g [label="actas y convenio"];
