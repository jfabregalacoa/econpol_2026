digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.15", nodesep="0.32", ranksep="0.20", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=17, margin="0.17,0.08", penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=14, color="#8091A4", fontcolor="#53647B", arrowsize=0.65, penwidth=1.2];
a [label=<<B>Comunidad / municipio</B><BR/>Proponer recuperación>,shape=box,fillcolor="#FBE9E0",color="#AA6243",fontcolor="#172E47"];
b [label=<<B>Alcalde + concejo</B><BR/>Respaldar y comprometer<BR/>aporte municipal>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
c [label=<<B>SEREMI + SERVIU</B><BR/>Revisión técnica<BR/>y comisión regional>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
d [label=<<B>Subsecretaría MINVU</B><BR/>Seleccionar y distribuir<BR/>recursos disponibles>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
e [label=<<B>SERVIU + proyectistas</B><BR/>Diseño aprobado<BR/>y habilitación SNI>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
f [label=<<B>SERVIU ↔ municipio</B><BR/>Convenio: aportes<BR/>y mantención>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
g [label=<<B>SERVIU</B><BR/>Licitación e inspección<BR/>de obra · T02>,shape=box,fillcolor="#E0F2EF",color="#297D77",fontcolor="#172E47"];
h [label=<<B>Municipalidad</B><BR/>Recibir y mantener>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
a -> b [label=""];
b -> c [label="expediente a SEREMI"];
c -> b [label="",constraint=false,style=dashed];
c -> d [label="nómina priorizada"];
d -> e [label="selección\ncomunicada"];
e -> f [label=""];
f -> g [label="recursos\nhabilitados"];
g -> h [label="entrega formal"];
}