digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.15", nodesep="0.32", ranksep="0.20", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=17, margin="0.17,0.08", penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=14, color="#8091A4", fontcolor="#53647B", arrowsize=0.65, penwidth=1.2];
a [label=<<B>Alcalde + SECPLA</B><BR/>Formular y presentar<BR/>proyecto de plaza>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
b [label=<<B>Equipo técnico GORE</B><BR/>Revisar pertinencia<BR/>y admisibilidad>,shape=box,fillcolor="#EFE9FA",color="#7960A3",fontcolor="#172E47"];
c [label=<<B>Formulador + financiador</B><BR/>Evaluación SNI o<BR/>exención aplicable · T01>,shape=box,fillcolor="#FFF0CE",color="#AD8425",fontcolor="#172E47"];
d [label=<<B>¿Expediente<BR/>habilitado?</B>>,shape=diamond,fillcolor="#FFF0CE",color="#AD8425",fontcolor="#172E47"];
e [label=<<B>SECPLA</B><BR/>Subsanar observaciones>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
f [label=<<B>Gobernador + CORE</B><BR/>Priorizar y financiar<BR/>según competencias>,shape=box,fillcolor="#EFE9FA",color="#7960A3",fontcolor="#172E47"];
g [label=<<B>GORE ↔ unidad técnica</B><BR/>Resolución y convenio<BR/>Municipio o servicio>,shape=box,fillcolor="#EFE9FA",color="#7960A3",fontcolor="#172E47"];
h [label=<<B>Unidad ejecutora → operador</B><BR/>Obra T02 → mantención>,shape=box,fillcolor="#E8F0FC",color="#376596",fontcolor="#172E47"];
a -> b [label="oficio y\nantecedentes"];
b -> c [label="postulación BIP"];
c -> d [label=""];
d -> e [label="no"];
e -> c [label="",constraint=false,style=dashed];
d -> f [label="sí; no garantiza\nrecursos"];
f -> g [label="asignación"];
g -> h [label="mandato /\ntransferencia"];
}